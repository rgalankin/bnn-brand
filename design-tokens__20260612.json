{
  "meta": {
    "brand": "Бизнес на нейронах",
    "version": "2.0",
    "created": "2026-06-12",
    "concept": "Renaissance meets Futurism"
  },
  "colors": {
    "circuit_deep": {
      "name": "Circuit Deep",
      "hex": "#0A1628",
      "rgb": "rgb(10, 22, 40)",
      "role": "Основной тёмный фон. Глубина, серьёзность, пространство.",
      "usage": ["фон страниц", "фон секций", "фон карточек"],
      "never": ["текст на светлом фоне", "иконки"]
    },
    "marble_white": {
      "name": "Marble White",
      "hex": "#F5F0E8",
      "rgb": "rgb(245, 240, 232)",
      "role": "Основной светлый фон. Тепло, классика, читаемость.",
      "usage": ["светлые страницы", "текст на тёмном фоне", "светлые карточки"],
      "never": ["фон логотипа без охранной зоны"]
    },
    "renaissance_gold": {
      "name": "Renaissance Gold",
      "hex": "#C9A84C",
      "rgb": "rgb(201, 168, 76)",
      "role": "Акцент — мастерство, ценность, проверенное временем.",
      "usage": ["заголовки на тёмном фоне", "ключевые цифры в кейсах", "логотип (рука человека)", "иконки в документах", "hover-состояния"],
      "never": ["фоновый цвет для больших блоков", "в равных долях с Neural Teal"]
    },
    "neural_teal": {
      "name": "Neural Teal",
      "hex": "#00B4D8",
      "rgb": "rgb(0, 180, 216)",
      "role": "AI, агенты, технологический слой.",
      "usage": ["механическая рука логотипа", "UI-кнопки", "Telegram-визуалы про агентов", "технические акценты"],
      "never": ["контексты про людей", "команда", "история", "ценности"]
    },
    "fresco_terracotta": {
      "name": "Fresco Terracotta",
      "hex": "#C67B5C",
      "rgb": "rgb(198, 123, 92)",
      "role": "Человек, история, команда, тепло.",
      "usage": ["секции про CEO и команду", "origin story", "человеческие контексты", "тёплые визуалы"],
      "never": ["AI и технологические контексты"]
    }
  },
  "typography": {
    "serif": {
      "family": "Cormorant Garamond",
      "source": "Google Fonts",
      "import": "@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&display=swap')",
      "usage": "H1, цитаты, эпиграфы",
      "weights": {
        "light": 300,
        "regular": 400,
        "semibold": 600
      },
      "never": "Bold Italic (теряет изящество)"
    },
    "sans": {
      "family": "Space Grotesk",
      "source": "Google Fonts",
      "import": "@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&display=swap')",
      "usage": "Тело текста, UI, метрики, H2–H4",
      "weights": {
        "light": 300,
        "regular": 400,
        "medium": 500,
        "bold": 700
      }
    },
    "mono": {
      "family": "JetBrains Mono",
      "source": "Google Fonts",
      "usage": "Код, технические данные, hex-коды"
    },
    "scale": {
      "h1": { "font": "Cormorant Garamond", "size": "48px", "weight": 400, "lineHeight": 1.2 },
      "h2": { "font": "Space Grotesk", "size": "32px", "weight": 700, "lineHeight": 1.3 },
      "h3": { "font": "Space Grotesk", "size": "24px", "weight": 500, "lineHeight": 1.4 },
      "h4": { "font": "Space Grotesk", "size": "20px", "weight": 500, "lineHeight": 1.4 },
      "body": { "font": "Space Grotesk", "size": "16px", "weight": 400, "lineHeight": 1.6 },
      "caption": { "font": "Space Grotesk", "size": "13px", "weight": 400, "lineHeight": 1.5 },
      "metric": { "font": "Space Grotesk", "size": "36px", "weight": 700, "lineHeight": 1.1 },
      "quote": { "font": "Cormorant Garamond", "size": "28px", "weight": 300, "lineHeight": 1.5 }
    },
    "rules": [
      "H1 только Cormorant Garamond, минимум 32px",
      "Тело текста только Space Grotesk",
      "Метрики и цифры — Space Grotesk Bold 36px+",
      "Не смешивать шрифты в одном заголовке",
      "Cormorant Garamond Bold Italic — запрещён"
    ]
  },
  "spacing": {
    "base": "8px",
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "40px",
    "xxl": "64px",
    "section": "80px",
    "page_margin": "60px"
  },
  "logo": {
    "concept": "Сотворение Адама — момент передачи искры",
    "human_hand_color": "#C9A84C",
    "robot_hand_color": "#00B4D8",
    "robot_hand_color_rule": "Neural Teal (#00B4D8) — неизменен абсолютно",
    "clearspace": "высота одной «руки» со всех сторон (~18% высоты изображения)",
    "clearspace_unit": "1x = высота одной руки логотипа",
    "min_size_digital": "120px",
    "min_size_digital_note": "при меньшем размере детали нечитаемы",
    "min_size_print": "25mm",
    "aspect_ratio": "1.35:1 (ширина к высоте кадра)",
    "object_position": "center 45% (смещение вниз — руки в центре кадра)",
    "forbidden": [
      "тень",
      "свечение",
      "поворот",
      "деформация",
      "перекраска механической руки",
      "низкое разрешение"
    ]
  },
  "contrast_pairs": {
    "_note": "Данные из Claude Design v2.0 секция 03. WCAG AA = 4.5:1 для текста, AAA = 7:1",
    "wcag_pass": [
      {
        "text_color": "#C9A84C",
        "text_name": "Renaissance Gold",
        "bg_color": "#0A1628",
        "bg_name": "Circuit Deep",
        "ratio": "7.9:1",
        "level": "AAA",
        "use": "Заголовки Cormorant Garamond, акцентные числа на тёмном фоне"
      },
      {
        "text_color": "#00B4D8",
        "text_name": "Neural Teal",
        "bg_color": "#0A1628",
        "bg_name": "Circuit Deep",
        "ratio": "7.4:1",
        "level": "AAA",
        "use": "AI-данные, чипы агентов, технические акценты — только на тёмном"
      },
      {
        "text_color": "#F5F0E8",
        "text_name": "Marble White",
        "bg_color": "#0A1628",
        "bg_name": "Circuit Deep",
        "ratio": "16:1",
        "level": "AAA",
        "use": "Основной текст, подписи на тёмном фоне"
      },
      {
        "text_color": "#C67B5C",
        "text_name": "Fresco Terracotta",
        "bg_color": "#0A1628",
        "bg_name": "Circuit Deep",
        "ratio": "5.5:1",
        "level": "AA",
        "use": "Тёплые акценты, нумерация 'нет'-списков — только крупный текст (18px+)"
      },
      {
        "text_color": "#0A1628",
        "text_name": "Circuit Deep",
        "bg_color": "#F5F0E8",
        "bg_name": "Marble White",
        "ratio": "16:1",
        "level": "AAA",
        "use": "Основной текст, заголовки на светлом фоне"
      },
      {
        "text_color": "#0A1628",
        "text_name": "Circuit Deep",
        "bg_color": "#C9A84C",
        "bg_name": "Renaissance Gold",
        "ratio": "7.9:1",
        "level": "AAA",
        "use": "Текст на кнопках и плашках Gold-фона (CTA-кнопки)"
      }
    ],
    "wcag_fail_decorative_only": [
      {
        "text_color": "#C9A84C",
        "text_name": "Renaissance Gold",
        "bg_color": "#F5F0E8",
        "bg_name": "Marble White",
        "ratio": "2.0:1",
        "level": "FAIL",
        "use": "Только линии, разделители, плашки, крупная графика. НЕ для текста никогда."
      },
      {
        "text_color": "#00B4D8",
        "text_name": "Neural Teal",
        "bg_color": "#F5F0E8",
        "bg_name": "Marble White",
        "ratio": "2.2:1",
        "level": "FAIL",
        "use": "Только линии, декоративные плашки. НЕ для текста никогда."
      }
    ],
    "rule": "На светлом фоне #F5F0E8 текст — всегда Circuit Deep #0A1628. Gold и Teal допустимы только как декор."
  },
  "gradients": {
    "cover_фреска": {
      "name": "Cover Overlay — вариант Фреска",
      "css": "linear-gradient(to bottom, rgba(10,22,40,0.25) 0%, rgba(10,22,40,0.05) 35%, rgba(10,22,40,0.55) 70%, #0A1628 100%)",
      "use": "Затемнение фотофона обложки. Даёт читаемость текста у низа при сохранении видимости фото вверху."
    },
    "selection_highlight": {
      "name": "Gold Selection",
      "css": "rgba(201, 168, 76, 0.35)",
      "use": "::selection — выделение текста. Бренд-цвет даже при выделении."
    }
  },
