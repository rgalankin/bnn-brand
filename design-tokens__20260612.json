  "emoji_palette": {
    "allowed": {
      "🧠": "AI / интеллект",
      "⚡": "скорость / результат",
      "🎯": "точность / цель",
      "💡": "идея / insight",
      "📌": "важное / закрепить",
      "✅": "подтверждение / выполнено",
      "→": "логика / переход (текстовый символ)"
    },
    "forbidden": {
      "🔥": "инфантильный хайп",
      "💯": "инфантильный хайп",
      "🚀": "банальность стартапов",
      "🙏": "заискивание",
      "😍": "инфантильный тон",
      "🥳": "инфантильный тон",
      "💸": "вульгарность"
    },
    "rules": [
      "Максимум 7 эмодзи на пост",
      "Только в начале строки или конце предложения",
      "Никогда в середине предложения"
    ]
  },
  "forbidden_words": [
    "революционный",
    "прорывной",
    "трансформирует",
    "меняет всё",
    "беспрецедентный",
    "полностью автоматизирует",
    "лидер мнений",
    "инновационный",
    "экосистема",
    "значительно улучшили",
    "существенный ROI",
    "будущее уже здесь",
    "AI заменит человека",
    "без выходных без декретов без налогов",
    "ООО Кредо-Сервис",
    "Бизнес на нейронах (в ZaBota-коммуникациях)"
  ],
  "tov_principles": [
    {
      "id": 1,
      "name": "Сначала вывод",
      "rule": "Не подводи читателя к мысли — скажи её сразу, потом объясни"
    },
    {
      "id": 2,
      "name": "Конкретика, не декларации",
      "rule": "Если есть число — называй число. «Значительно» — не слово для БНН"
    },
    {
      "id": 3,
      "name": "Ограничения — сила",
      "rule": "Честность про ограничения — признак зрелости, а не уязвимость"
    },
    {
      "id": 4,
      "name": "Без AI-хайпа",
      "rule": "Запрещены: революционный, прорывной, меняет всё, будущее уже здесь"
    },
    {
      "id": 5,
      "name": "Равный с равным",
      "rule": "Аудитория — предприниматели. Говори как равный с равным, не ментор с кафедры"
    },
    {
      "id": 6,
      "name": "237 агентов — аргумент",
      "rule": "Цифра появляется только там, где доказывает что-то конкретное"
    },
    {
      "id": 7,
      "name": "CEO — практик, не гуру",
      "rule": "Позиция: я иду впереди не потому что умнее — а потому что начал раньше"
    },
    {
      "id": 8,
      "name": "Кейс — история",
      "rule": "Кейс: проблема → агент → измеримый результат. Функции внутри, не снаружи"
    },
    {
      "id": 9,
      "name": "Короткие предложения — акцент",
      "rule": "Когда мысль важная — делай предложение коротким. Пауза работает на акцент"
    },
    {
      "id": 10,
      "name": "Без заискивания",
      "rule": "Никаких 🙏, никаких «благодарим за доверие». Бренд говорит с позиции результата"
    },
    {
      "id": 11,
      "name": "Urgency — точка входа",
      "rule": "Urgency + конкретный шаг = мотивация. Urgency без пути = манипуляция"
    },
    {
      "id": 12,
      "name": "Экономический язык",
      "rule": "ROI, время, рубли. «Значительная экономия» — запрещено. Только конкретные числа"
    }
  ],
  "brand_promise": "Мастерство, усиленное технологией. Ты станешь сверхпредпринимателем.",
  "brand_personality": ["Мастерство", "Честность", "Конкретность"],
  "archetypes": ["Архитектор", "Практик", "Наставник"],
  "kasparov_formula": "Человек + AI > чистый AI"
